        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1072"
                TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts823">
                <ANNOTATION_VALUE>And then on the left, a rod consisting of two parts</ANNOTATION_VALUE>
