        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1046"
                TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts589">
                <ANNOTATION_VALUE>which one it is.</ANNOTATION_VALUE>
