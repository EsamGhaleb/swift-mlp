        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1025"
                TIME_SLOT_REF1="ts333" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>Yes, *9*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1026"
                TIME_SLOT_REF1="ts349" TIME_SLOT_REF2="ts351">
                <ANNOTATION_VALUE>Um this one is um totally not symmetrical.</ANNOTATION_VALUE>
