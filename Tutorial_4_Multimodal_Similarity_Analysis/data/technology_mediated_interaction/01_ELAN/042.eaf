        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1053"
                TIME_SLOT_REF1="ts625" TIME_SLOT_REF2="ts629">
                <ANNOTATION_VALUE>And then to the right of that rod another disk attached to it.</ANNOTATION_VALUE>
