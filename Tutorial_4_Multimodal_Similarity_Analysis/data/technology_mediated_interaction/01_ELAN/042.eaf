        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1070"
                TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts815">
                <ANNOTATION_VALUE>Some kind of, yes helicopter pad or something, where a helicopter could land on it</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1071"
                TIME_SLOT_REF1="ts817" TIME_SLOT_REF2="ts819">
                <ANNOTATION_VALUE>Suppose it were a building.</ANNOTATION_VALUE>
