        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1059"
                TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts711">
                <ANNOTATION_VALUE>So who stands in front of it</ANNOTATION_VALUE>
