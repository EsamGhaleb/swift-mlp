        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1076"
                TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts883">
                <ANNOTATION_VALUE>who half falls in.</ANNOTATION_VALUE>
