        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1021"
                TIME_SLOT_REF1="ts311" TIME_SLOT_REF2="ts313">
                <ANNOTATION_VALUE>Yes, then I think so.</ANNOTATION_VALUE>
