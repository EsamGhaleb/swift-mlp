        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1048"
                TIME_SLOT_REF1="ts603" TIME_SLOT_REF2="ts605">
                <ANNOTATION_VALUE>Um this I found eh one that did look a lot like a face</ANNOTATION_VALUE>
