        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1075"
                TIME_SLOT_REF1="ts865" TIME_SLOT_REF2="ts879">
                <ANNOTATION_VALUE>Um oh, and then also one of those kind of coin, flat circle behind it</ANNOTATION_VALUE>
