        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1027"
                TIME_SLOT_REF1="ts353" TIME_SLOT_REF2="ts361">
                <ANNOTATION_VALUE>He's on top, I was talking earlier about a pyramid that was chopped off, and this is a pyramid with a point.</ANNOTATION_VALUE>
