        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1024"
                TIME_SLOT_REF1="ts325" TIME_SLOT_REF2="ts331">
                <ANNOTATION_VALUE>also eh then you can't see it so well on the right, but on the left you can.</ANNOTATION_VALUE>
