        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1040"
                TIME_SLOT_REF1="ts483" TIME_SLOT_REF2="ts485">
                <ANNOTATION_VALUE>And that book then has two more kind of antennas</ANNOTATION_VALUE>
