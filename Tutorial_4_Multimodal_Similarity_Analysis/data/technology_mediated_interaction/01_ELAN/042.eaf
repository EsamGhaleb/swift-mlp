        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1061"
                TIME_SLOT_REF1="ts717" TIME_SLOT_REF2="ts719">
                <ANNOTATION_VALUE>And then on top of that he has a round ball.</ANNOTATION_VALUE>
