        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1020"
                TIME_SLOT_REF1="ts295" TIME_SLOT_REF2="ts303">
                <ANNOTATION_VALUE>Is the beam standing or lying on top?</ANNOTATION_VALUE>
