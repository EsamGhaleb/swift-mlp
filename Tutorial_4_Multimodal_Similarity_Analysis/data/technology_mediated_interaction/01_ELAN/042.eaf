        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054"
                TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>Um yeah, and those are pretty close together, right?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1055"
                TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>Yes, from small to large.</ANNOTATION_VALUE>
