        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1068"
                TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts803">
                <ANNOTATION_VALUE>I don't think it looks like a face either.</ANNOTATION_VALUE>
