        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1051"
                TIME_SLOT_REF1="ts615" TIME_SLOT_REF2="ts617">
                <ANNOTATION_VALUE>I thought it looked like one of those rings that bulls have through their noses.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1052"
                TIME_SLOT_REF1="ts619" TIME_SLOT_REF2="ts621">
                <ANNOTATION_VALUE>Even though it is not a ring, but a rod.</ANNOTATION_VALUE>
