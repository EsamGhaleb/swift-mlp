        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1036"
                TIME_SLOT_REF1="ts449" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>which yes like Pinocchio is just a kind of wooden rod.</ANNOTATION_VALUE>
