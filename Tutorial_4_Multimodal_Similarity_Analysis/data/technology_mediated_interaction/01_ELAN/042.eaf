        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1015"
                TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts227">
                <ANNOTATION_VALUE>It's not quite, but...</ANNOTATION_VALUE>
