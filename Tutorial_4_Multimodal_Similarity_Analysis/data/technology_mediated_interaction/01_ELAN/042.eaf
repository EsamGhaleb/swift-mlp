        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1077"
                TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts891">
                <ANNOTATION_VALUE>Oh yes, *13*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1078"
                TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts907">
                <ANNOTATION_VALUE>Um this one has two yes protrusions on the left and top that reminded me of a bowling pin.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1079"
                TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts919">
                <ANNOTATION_VALUE>And then on the right an eminence protuberance that is blocky</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1080"
                TIME_SLOT_REF1="ts921" TIME_SLOT_REF2="ts925">
                <ANNOTATION_VALUE>And going from small to large.</ANNOTATION_VALUE>
