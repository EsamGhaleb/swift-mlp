        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1062"
                TIME_SLOT_REF1="ts721" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>That ball is not completely round because it partially disappears into the large shape.</ANNOTATION_VALUE>
