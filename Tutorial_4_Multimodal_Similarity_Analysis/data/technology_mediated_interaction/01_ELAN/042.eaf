        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057"
                TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>Um this one is not compact.</ANNOTATION_VALUE>
