        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1083"
                TIME_SLOT_REF1="ts997" TIME_SLOT_REF2="ts999">
                <ANNOTATION_VALUE>Oh, we've already had this one.</ANNOTATION_VALUE>
