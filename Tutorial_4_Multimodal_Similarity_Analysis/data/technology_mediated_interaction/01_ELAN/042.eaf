        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1060"
                TIME_SLOT_REF1="ts713" TIME_SLOT_REF2="ts715">
                <ANNOTATION_VALUE>And (er) that is not attached to it.</ANNOTATION_VALUE>
