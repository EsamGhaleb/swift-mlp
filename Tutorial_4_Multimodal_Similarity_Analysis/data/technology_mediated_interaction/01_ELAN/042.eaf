        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1042"
                TIME_SLOT_REF1="ts507" TIME_SLOT_REF2="ts513">
                <ANNOTATION_VALUE>Yes, in the middle then was that nose.</ANNOTATION_VALUE>
