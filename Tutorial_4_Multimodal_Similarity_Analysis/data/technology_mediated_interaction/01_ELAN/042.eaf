        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1028"
                TIME_SLOT_REF1="ts363" TIME_SLOT_REF2="ts369">
                <ANNOTATION_VALUE>And that, in my opinion, is only one.</ANNOTATION_VALUE>
