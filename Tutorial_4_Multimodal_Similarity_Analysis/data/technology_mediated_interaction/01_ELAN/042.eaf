        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1037"
                TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts465">
                <ANNOTATION_VALUE>And then at the bottom a tube with a bend</ANNOTATION_VALUE>
