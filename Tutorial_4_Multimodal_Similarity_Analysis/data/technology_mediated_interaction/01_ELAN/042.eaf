        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1081"
                TIME_SLOT_REF1="ts929" TIME_SLOT_REF2="ts941">
                <ANNOTATION_VALUE>And then left slash behind another kind of round, or not straight bar.</ANNOTATION_VALUE>
