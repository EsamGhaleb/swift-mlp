        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1067"
                TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts799">
                <ANNOTATION_VALUE>Um this one is not symmetrical at all.</ANNOTATION_VALUE>
