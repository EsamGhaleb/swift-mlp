        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1073"
                TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts827">
                <ANNOTATION_VALUE>where again some kind of antenna juts out</ANNOTATION_VALUE>
