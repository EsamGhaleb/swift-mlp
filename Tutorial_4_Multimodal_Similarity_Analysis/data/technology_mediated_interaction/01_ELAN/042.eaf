        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1064"
                TIME_SLOT_REF1="ts733" TIME_SLOT_REF2="ts743">
                <ANNOTATION_VALUE>E- and two bars on the side.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1065"
                TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts783">
                <ANNOTATION_VALUE>Yes, that's what I had said, spoon and rod.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1066"
                TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts787">
                <ANNOTATION_VALUE>Um, *8*.</ANNOTATION_VALUE>
