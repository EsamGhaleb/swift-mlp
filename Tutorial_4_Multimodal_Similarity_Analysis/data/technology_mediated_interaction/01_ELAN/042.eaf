        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1032"
                TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts421">
                <ANNOTATION_VALUE>Yes, the only one with a real bottom, right?</ANNOTATION_VALUE>
