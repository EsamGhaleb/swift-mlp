        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1063"
                TIME_SLOT_REF1="ts725" TIME_SLOT_REF2="ts727">
                <ANNOTATION_VALUE>I think that is the only one that has a round ball on top.</ANNOTATION_VALUE>
