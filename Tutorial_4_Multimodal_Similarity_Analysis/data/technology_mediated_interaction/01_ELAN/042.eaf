        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1069"
                TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts809">
                <ANNOTATION_VALUE>To the right is a circular plateau.</ANNOTATION_VALUE>
