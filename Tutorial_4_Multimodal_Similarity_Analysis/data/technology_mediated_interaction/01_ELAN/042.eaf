        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1058"
                TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts704">
                <ANNOTATION_VALUE>This one is also one of the few to have a rod that, as I see it, is separate from it.</ANNOTATION_VALUE>
