        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1014"
                TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>Yes, so- yes sort of.</ANNOTATION_VALUE>
