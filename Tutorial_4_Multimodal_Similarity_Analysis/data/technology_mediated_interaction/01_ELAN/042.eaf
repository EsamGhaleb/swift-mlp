        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1023"
                TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts323">
                <ANNOTATION_VALUE>He has almost the same left and right, right?</ANNOTATION_VALUE>
