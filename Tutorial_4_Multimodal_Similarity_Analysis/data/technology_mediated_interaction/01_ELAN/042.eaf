        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1011"
                TIME_SLOT_REF1="ts193" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>Is it already?</ANNOTATION_VALUE>
