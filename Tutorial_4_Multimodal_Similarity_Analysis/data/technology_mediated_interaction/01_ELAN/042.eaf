        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1082"
                TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts985">
                <ANNOTATION_VALUE>Yes, number *1*.</ANNOTATION_VALUE>
