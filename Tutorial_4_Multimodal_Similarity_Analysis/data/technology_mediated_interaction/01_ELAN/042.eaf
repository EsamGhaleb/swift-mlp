        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1033"
                TIME_SLOT_REF1="ts427" TIME_SLOT_REF2="ts429">
                <ANNOTATION_VALUE>Yes, *2*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1034"
                TIME_SLOT_REF1="ts439" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>Um this um I had described as Pinocchio</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1035"
                TIME_SLOT_REF1="ts445" TIME_SLOT_REF2="ts447">
                <ANNOTATION_VALUE>with a long nose</ANNOTATION_VALUE>
