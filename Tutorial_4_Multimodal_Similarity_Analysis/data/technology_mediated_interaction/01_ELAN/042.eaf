        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1030"
                TIME_SLOT_REF1="ts387" TIME_SLOT_REF2="ts389">
                <ANNOTATION_VALUE>and on the right something with each side something different.</ANNOTATION_VALUE>
