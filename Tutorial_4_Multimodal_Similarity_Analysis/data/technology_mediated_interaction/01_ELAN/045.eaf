        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1557"
                TIME_SLOT_REF1="ts368" TIME_SLOT_REF2="ts370">
                <ANNOTATION_VALUE>Zeker, dus dan is het *E*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1558"
                TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts388">
                <ANNOTATION_VALUE>Oké, deze is een kopje die heeft twee soort van lepeltjes die erin hangen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1559"
                TIME_SLOT_REF1="ts394" TIME_SLOT_REF2="ts398">
                <ANNOTATION_VALUE>Ehm eén lepeltje is een soort van vierkant</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1560"
                TIME_SLOT_REF1="ts400" TIME_SLOT_REF2="ts404">
                <ANNOTATION_VALUE>en die ander heeft een wat andere vorm.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1561"
                TIME_SLOT_REF1="ts406" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Er zit een soort van bolletje op de romp</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
