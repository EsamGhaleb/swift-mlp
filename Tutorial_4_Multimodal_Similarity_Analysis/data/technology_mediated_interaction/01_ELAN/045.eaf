        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1556"
                TIME_SLOT_REF1="ts358" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Oké, ik...</ANNOTATION_VALUE>
