        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1562"
                TIME_SLOT_REF1="ts412" TIME_SLOT_REF2="ts416">
                <ANNOTATION_VALUE>en een driehoekig uitsteekseltje.</ANNOTATION_VALUE>
