        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1563"
                TIME_SLOT_REF1="ts422" TIME_SLOT_REF2="ts426">
                <ANNOTATION_VALUE>Eh ja.</ANNOTATION_VALUE>
