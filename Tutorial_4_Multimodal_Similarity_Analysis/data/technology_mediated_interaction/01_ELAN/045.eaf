    <TIER LINGUISTIC_TYPE_REF="imported-sep" PARTICIPANT="01" TIER_ID="A_speech">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1527"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>Ja, ik weet niet of we al zijn begonnen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1528"
                TIME_SLOT_REF1="ts20" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Oh, dan eh ja nee dan is het bij mij.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1529"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Nee, ik dacht eh</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1530"
                TIME_SLOT_REF1="ts38" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Oh, deze, ja.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1531"
                TIME_SLOT_REF1="ts46" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>eh ik zal het eerst omschrijven.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1532"
                TIME_SLOT_REF1="ts50" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>En als dat niet lukt, dan kunnen we nog een beetje dingen uitbeelden.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1533"
                TIME_SLOT_REF1="ts60" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>Sommige vormen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1534"
                TIME_SLOT_REF1="ts74" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Ehm dan kijken we wel hoe het gaat.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1535"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Dit is zo'n eh zo'n blauw kopje</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1536"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts90">
                <ANNOTATION_VALUE>en hij heeft zo'n soort van blokje aan één kant</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1537"
                TIME_SLOT_REF1="ts92" TIME_SLOT_REF2="ts96">
                <ANNOTATION_VALUE>en een arm aan de andere kant.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1538"
                TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts104">
                <ANNOTATION_VALUE>En hij staat op een soort van schuin eh onderzetter of iets zoiets</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1539"
                TIME_SLOT_REF1="ts106" TIME_SLOT_REF2="ts108">
                <ANNOTATION_VALUE>waar standbeelden ook op staan.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1540"
                TIME_SLOT_REF1="ts114" TIME_SLOT_REF2="ts124">
                <ANNOTATION_VALUE>Ja, zo'n eh ja een soort voetstuk</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1541"
                TIME_SLOT_REF1="ts126" TIME_SLOT_REF2="ts134">
                <ANNOTATION_VALUE>en er zit een soort van draai in.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1542"
                TIME_SLOT_REF1="ts144" TIME_SLOT_REF2="ts150">
                <ANNOTATION_VALUE>Ja, precies.</ANNOTATION_VALUE>
