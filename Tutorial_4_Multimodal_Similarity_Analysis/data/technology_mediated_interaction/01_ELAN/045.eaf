        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1548"
                TIME_SLOT_REF1="ts256" TIME_SLOT_REF2="ts258">
                <ANNOTATION_VALUE>Ja, ja.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1549"
                TIME_SLOT_REF1="ts260" TIME_SLOT_REF2="ts264">
                <ANNOTATION_VALUE>En die steeltjes dezelfde vorm als een van die armen.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1550"
                TIME_SLOT_REF1="ts266" TIME_SLOT_REF2="ts270">
                <ANNOTATION_VALUE>Oké, dan is het *L*.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1551"
                TIME_SLOT_REF1="ts280" TIME_SLOT_REF2="ts284">
                <ANNOTATION_VALUE>Oké, dan hebben we weer een eh een kopje met een soort van eh zeshoekig uitstekend dingetje naar links.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1552"
                TIME_SLOT_REF1="ts286" TIME_SLOT_REF2="ts290">
                <ANNOTATION_VALUE>Hij staat ook weer op een soort van onderzettetje.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1553"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts300">
                <ANNOTATION_VALUE>En er steekt een klein dingetje uit.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1554"
                TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts314">
                <ANNOTATION_VALUE>Ja, ja, ja, precies.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1555"
                TIME_SLOT_REF1="ts346" TIME_SLOT_REF2="ts350">
